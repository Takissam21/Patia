(define (domain sokoban)
  (:requirements :strips :typing :negative-preconditions)

  (:types
    cell box
  )

  (:predicates
    (player-at ?c - cell)
    (box-at ?b - box ?c - cell)
    (clear ?c - cell)
    (goal ?c - cell)
    (deadlock ?c - cell)
    (filled ?c - cell)

    (up ?from - cell ?to - cell)
    (down ?from - cell ?to - cell)
    (left ?from - cell ?to - cell)
    (right ?from - cell ?to - cell)
  )

  (:action move-up
    :parameters (?from - cell ?to - cell)
    :precondition (and
      (player-at ?from)
      (up ?from ?to)
      (clear ?to)
    )
    :effect (and
      (not (player-at ?from))
      (player-at ?to)
      (clear ?from)
      (not (clear ?to))
    )
  )

  (:action move-down
    :parameters (?from - cell ?to - cell)
    :precondition (and
      (player-at ?from)
      (down ?from ?to)
      (clear ?to)
    )
    :effect (and
      (not (player-at ?from))
      (player-at ?to)
      (clear ?from)
      (not (clear ?to))
    )
  )

  (:action move-left
    :parameters (?from - cell ?to - cell)
    :precondition (and
      (player-at ?from)
      (left ?from ?to)
      (clear ?to)
    )
    :effect (and
      (not (player-at ?from))
      (player-at ?to)
      (clear ?from)
      (not (clear ?to))
    )
  )

  (:action move-right
    :parameters (?from - cell ?to - cell)
    :precondition (and
      (player-at ?from)
      (right ?from ?to)
      (clear ?to)
    )
    :effect (and
      (not (player-at ?from))
      (player-at ?to)
      (clear ?from)
      (not (clear ?to))
    )
  )

  (:action push-up
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
      (up ?player ?boxcell)
      (up ?boxcell ?dest)
      (clear ?dest)
      (not (deadlock ?dest))
      (not (goal ?boxcell))
      (not (goal ?dest))
    )
    :effect (and
      (not (player-at ?player))
      (player-at ?boxcell)
      (not (box-at ?b ?boxcell))
      (box-at ?b ?dest)
      (clear ?player)
      (not (clear ?boxcell))
      (not (clear ?dest))
    )
  )

  (:action push-up-to-goal
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
      (up ?player ?boxcell)
      (up ?boxcell ?dest)
      (clear ?dest)
      (not (goal ?boxcell))
      (goal ?dest)
    )
    :effect (and
      (not (player-at ?player))
      (player-at ?boxcell)
      (not (box-at ?b ?boxcell))
      (box-at ?b ?dest)
      (clear ?player)
      (not (clear ?boxcell))
      (not (clear ?dest))
      (filled ?dest)
    )
  )

  (:action push-up-from-goal
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
