      (goal ?dest)
    )
    :effect (and
      (not (player-at ?player))
      (player-at ?boxcell)
      (not (box-at ?b ?boxcell))
      (box-at ?b ?dest)
      (clear ?player)
      (not (clear ?boxcell))
      (not (clear ?dest))
      (filled ?dest)
    )
  )

  (:action push-left-from-goal
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
      (left ?player ?boxcell)
      (left ?boxcell ?dest)
      (clear ?dest)
      (not (deadlock ?dest))
      (goal ?boxcell)
      (not (goal ?dest))
      (filled ?boxcell)
    )
    :effect (and
