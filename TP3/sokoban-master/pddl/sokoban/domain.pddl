      (goal ?boxcell)
      (not (goal ?dest))
      (filled ?boxcell)
    )
    :effect (and
      (not (player-at ?player))
      (player-at ?boxcell)
      (not (box-at ?b ?boxcell))
      (box-at ?b ?dest)
      (clear ?player)
      (not (clear ?boxcell))
      (not (clear ?dest))
      (not (filled ?boxcell))
    )
  )

  (:action push-up-goal-to-goal
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
      (up ?player ?boxcell)
      (up ?boxcell ?dest)
      (clear ?dest)
      (goal ?boxcell)
      (goal ?dest)
      (filled ?boxcell)
    )
    :effect (and
      (not (player-at ?player))
      (player-at ?boxcell)
      (not (box-at ?b ?boxcell))
      (box-at ?b ?dest)
      (clear ?player)
      (not (clear ?boxcell))
      (not (clear ?dest))
      (not (filled ?boxcell))
      (filled ?dest)
    )
  )

  (:action push-down
    :parameters (?b - box ?player - cell ?boxcell - cell ?dest - cell)
    :precondition (and
      (player-at ?player)
      (box-at ?b ?boxcell)
      (down ?player ?boxcell)
      (down ?boxcell ?dest)
      (clear ?dest)
      (not (deadlock ?dest))
      (not (goal ?boxcell))
      (not (goal ?dest))
    )
    :effect (and
